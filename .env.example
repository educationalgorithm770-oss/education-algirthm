# ==========================================================
# Education Algorithm — Environment Configuration Template
# Copy this file to .env and configure your production values
# ==========================================================

APP_ENV=production
APP_URL=https://yourdomain.com

# Database Connection
# In production, use a dedicated user with SELECT, INSERT, UPDATE, DELETE privileges only
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_secure_database_password

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_key_secret
ALLOW_DEV_PAYMENT=false

# AI Assistant (Google Gemini)
GEMINI_API_KEY=your_production_gemini_api_key

# Transactional SMTP Mail
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_or_smtp_password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME="Education Algorithm"

