# ── Education Algorithm Production Environment Variables ────────────────────
# Copy this file to .env.production on your Hostinger KVM 1 VPS

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://educationalgorithm.com

# Database (Automatically mapped by Docker container)
DB_HOST=db
DB_PORT=3306
DB_NAME=education_production
DB_USER=app_user
DB_PASSWORD=ChangeMeStrongDatabasePassword2026!
DB_ROOT_PASSWORD=ChangeMeRootSecurePassword2026!

# Authentication Security (Generate 64-char key: openssl rand -base64 64)
JWT_SECRET=replace_with_64_character_random_string_for_production_jwt

# Live Razorpay Credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_live_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Google Gemini AI Production Key Pool (comma-separated for failover)
GEMINI_API_KEYS=AIzaSyA_ProductionKey1,AIzaSyB_ProductionKey2
